import java.util.Scanner;

public class CompetenciaProgramacion {

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        double reto1, reto2, reto3;
        int errores, tiempo;
        String desafioExtra, copia;
        double puntajeBase, penalizacion, bonificacion, puntajeFinal;
        String nivel, observacion;

        // Entrada de datos
        do {
            System.out.print("Ingrese puntaje del reto 1: ");
            reto1 = entrada.nextDouble();

            System.out.print("Ingrese puntaje del reto 2: ");
            reto2 = entrada.nextDouble();

            System.out.print("Ingrese puntaje del reto 3: ");
            reto3 = entrada.nextDouble();

            if (reto1 < 0 || reto2 < 0 || reto3 < 0) {
                System.out.println("Los puntajes no pueden ser negativos.");
            }

        } while (reto1 < 0 || reto2 < 0 || reto3 < 0);

        do {
            System.out.print("Ingrese numero de errores: ");
            errores = entrada.nextInt();

            if (errores < 0) {
                System.out.println("Los errores no pueden ser negativos.");
            }

        } while (errores < 0);

        do {
            System.out.print("Ingrese tiempo total en minutos: ");
            tiempo = entrada.nextInt();

            if (tiempo <= 0) {
                System.out.println("El tiempo debe ser mayor que 0.");
            }

        } while (tiempo <= 0);

        entrada.nextLine();

        do {
            System.out.print("¿Resolvio el desafio extra? (Si/No): ");
            desafioExtra = entrada.nextLine();

            if (!desafioExtra.equalsIgnoreCase("Si") &&
                !desafioExtra.equalsIgnoreCase("No")) {
                System.out.println("Ingrese solamente Si o No.");
            }

        } while (!desafioExtra.equalsIgnoreCase("Si") &&
                 !desafioExtra.equalsIgnoreCase("No"));

        do {
            System.out.print("¿Fue descalificado por copia? (Si/No): ");
            copia = entrada.nextLine();

            if (!copia.equalsIgnoreCase("Si") &&
                !copia.equalsIgnoreCase("No")) {
                System.out.println("Ingrese solamente Si o No.");
            }

        } while (!copia.equalsIgnoreCase("Si") &&
                 !copia.equalsIgnoreCase("No"));

        // Procesos
        puntajeBase = reto1 + reto2 + reto3;

        penalizacion = errores * 4;

        bonificacion = 0;

        if (desafioExtra.equalsIgnoreCase("Si")) {
            bonificacion = bonificacion + 15;
        }

        if (tiempo < 30) {
            bonificacion = bonificacion + 10;
        }

        puntajeFinal = puntajeBase - penalizacion + bonificacion;

        if (puntajeFinal < 0) {
            puntajeFinal = 0;
        }

        // Determinar nivel
        if (copia.equalsIgnoreCase("Si")) {
            nivel = "Descalificado";
        } else if (puntajeFinal < 30) {
            nivel = "Principiante";
        } else if (puntajeFinal < 50) {
            nivel = "Basico";
        } else if (puntajeFinal < 70) {
            nivel = "Intermedio";
        } else if (puntajeFinal < 90) {
            nivel = "Avanzado";
        } else {
            nivel = "Experto";
        }

        // Observación
        observacion = "Sin observaciones";

        if (puntajeFinal >= 90 && errores > 5) {
            observacion = "Resultado inconsistente: revisar calidad de resolucion";
        }

